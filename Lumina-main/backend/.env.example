# ============================================================================
# LUMINA BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# Copy this file to .env and fill in the values for local or cloud deployment.

# Node Server Port (Render / Railway assign PORT automatically)
PORT=5001
NODE_ENV=production

# Frontend URL(s) allowed to access this API via CORS
# In production, specify your frontend URL(s), comma-separated:
# e.g.: https://luminaa.vercel.app,https://luminaa-1ffe1.web.app
FRONTEND_URL=http://localhost:5173

# Groq API Key (Get a free key from https://console.groq.com)
# Powers Leo the Tiger AI assistant with Llama 3.3 70B
GROQ_API_KEY=your_groq_api_key_here

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=luminaa-1ffe1.firebasestorage.app

# Firebase Admin Service Account (Optional for basic Leo assist; required for database seeding)
# Option A (Cloud): Paste the single-line JSON string of your serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"luminaa-1ffe1",...}
#
# Option B (Local file path):
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
