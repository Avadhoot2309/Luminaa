# ============================================================================
# LUMINA FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# Copy this file to .env in frontend/ and fill in the corresponding values.

# Backend API Service URL
# Local development default: http://localhost:5001
# Production deployment: URL of your deployed backend (e.g., https://lumina-backend.onrender.com)
VITE_API_URL=http://localhost:5001

# Firebase Configuration (From Firebase Console -> Project Settings -> General -> Web App)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Groq Cloud API (Optional client-side fallback; get key from https://console.groq.com)
VITE_GROQ_API_KEY=your_groq_api_key

# Cloudinary (Media and document uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_preset

# Feature Toggles & Environment
VITE_USE_CLIENT_SIDE_TTS=true
VITE_USE_CLIENT_SIDE_OCR=true
VITE_ENV=development

